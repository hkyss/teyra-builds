{
  "format": 16,
  "id": "skyrim-se",
  "title": "Foundation Build",
  "version": "1.0.0",
  "authors": [{ "name": "hkyss" }],
  "license": "GPL-3.0",
  "description": {
    "en": "A clean Skyrim to build your own mod list on. Teyra keeps its own copy at 1.7.104, so the next Steam update won't break your SKSE plugins. It crashes less than the stock game, and when it does, the log says why.",
    "ru": "Чистый Skyrim, на котором собирают свой список модов. Teyra держит отдельную копию игры версии 1.7.104, и очередное обновление в Steam не сломает плагины SKSE. Вылетает реже обычной игры, а если вылетит, в журнале будет причина."
  },
  "category": "advanced",
  "gameId": "skyrim-se",
  "folder": "Foundation Build",
  "options": [
    { "id": "language", "kind": "language", "values": ["english", "russian"], "default": "english" },
    { "id": "profile", "kind": "profile", "labels": { "Base": { "ru": "Основной" }, "Test": { "ru": "Тестовый" } } }
  ],
  "art": {
    "monogram": "SSE",
    "tile": "linear-gradient(140deg, #5e7a9c 0%, #2a3a52 100%)",
    "glow": ["#6f9bd8", "#8b7bff", "#3ad1c4"]
  },
  "mods": [
    {
      "name": "Skyrim Script Extender",
      "nexusId": 30379,
      "file": "Skyrim Script Extender (SKSE64) Steam",
      "version": "2.3.1",
      "target": "game",
      "expect": ["Scripts/Actor.pex"],
      "expectGame": ["skse64_loader.exe"]
    },
    {
      "name": "Address Library for SKSE Plugins",
      "nexusId": 32444,
      "file": "Address Library All in One (1.7.104.0) v13",
